# Contact form endpoint. Both are optional and both are read at BUILD time —
# changing either needs a rebuild, not a restart. See README "Contact form".
#
# Unset is a supported state: the form still renders and collects, and
# submitting hands the visitor a pre-filled mail draft instead of POSTing.

# Formspree: https://formspree.io/f/<form-id>   (no key needed)
# Web3Forms: https://api.web3forms.com/submit   (key required, below)
VITE_CONTACT_FORM_ENDPOINT=

# Sent as an "access_key" field. Web3Forms wants one; Formspree does not.
VITE_CONTACT_FORM_KEY=
